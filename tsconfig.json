{
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": ".",
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "allowJs": true,
        "isolatedModules": true,
        "types": [
            "jest",
            "node"
        ]
    },
    "include": [
        "src",
        "eslint.config.js",
        "jest.config.cjs"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}