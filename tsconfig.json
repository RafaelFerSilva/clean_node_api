{
    "compilerOptions": {
        "outDir": "./dist",
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "allowJs": true
    },
    "include": [
        "src",
        "eslint.config.js",
        "jest.config.cjs"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}